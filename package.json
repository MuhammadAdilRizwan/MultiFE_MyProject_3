{
  "name": "multife",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "db:setup": "npm run db:setup -w @multife/backend --",
    "db:check": "npm run db:check -w @multife/backend",
    "create-admin": "npm run create-admin -w @multife/backend --",
    "seed:catalog": "npm run seed:catalog -w @multife/backend",
    "test:auth": "npm run test:auth -w @multife/backend",
    "test": "npm run test -w @multife/backend && npm run test -w frontend",
    "test:rls": "npm run test:rls -w @multife/backend"
  }
}
