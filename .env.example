# MultiFe — environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local.

# --- Supabase project (Dashboard → Project Settings → API) -------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable key — safe for the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connection (Dashboard → Connect → Session pooler) --------------
# Used by `npm run db:setup` to create the tables. Replace [YOUR-PASSWORD]
# with the database password you set when creating the project.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /register-brand so brands can contact the admin. Not secret, but
# server-read only. Leave blank and the page says details are coming soon.
MULTIFE_CONTACT_EMAIL=
MULTIFE_CONTACT_PHONE=

# --- Third parties (fill in later) -------------------------------------------
RESEND_API_KEY=
WHATSAPP_BSP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
